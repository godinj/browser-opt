{
  "manifest_version": 2,
  "name": "Browser Opt",
  "version": "0.1.0",
  "description": "Local-first browser activity and tab archive capture.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-opt@godin.local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "browser_action": {
    "default_title": "Browser Opt"
  },
  "commands": {
    "open-tab-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open tab search"
    },
    "open-action-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open action search"
    },
    "open-archived-tab-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Open archived tab search"
    },
    "open-terminal": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open Browser Opt terminal"
    },
    "group-selected-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Group selected tabs into a TST folder"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-link-hints.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "notifications",
    "tabs",
    "webNavigation",
    "webRequest",
    "cookies",
    "storage",
    "http://*/*",
    "https://*/*"
  ]
}
